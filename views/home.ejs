<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Global Blog Timeline</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; background-color: #f8f9fa; color: #212529; }
        .navbar { background: #ffffff; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #dee2e6; }
        .container { max-width: 650px; margin: 40px auto; padding: 0 20px; }
        .card { background: #ffffff; padding: 25px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 25px; border: 1px solid #e9ecef; }
        input, textarea { width: 100%; padding: 12px; margin: 10px 0 20px 0; border: 1px solid #ced4da; border-radius: 6px; box-sizing: border-box; }
        textarea { height: 120px; resize: vertical; }
        .btn { padding: 10px 18px; border-radius: 6px; border: none; cursor: pointer; font-weight: 500; text-decoration: none; display: inline-block; }
        .btn-primary { background: #0d6efd; color: white; }
        .btn-danger { background: #dc3545; color: white; }
        .btn-secondary { background: #6c757d; color: white; }
        .meta { font-size: 0.85em; color: #6c757d; margin-top: 5px; margin-bottom: 15px; }
    </style>
</head>
<body>

    <!-- Top Navigation Header bar -->
    <nav class="navbar">
        <h2>Global Blog Feed</h2>
        <div>
            <span style="margin-right:15px;">Active Profile: <strong>@<%= username %></strong></span>
            <a href="/logout" class="btn btn-secondary">Log Out</a>
        </div>
    </nav>

    <div class="container">
        <!-- Composition Form Card -->
        <div class="card">
            <h3>Publish a New Entry</h3>
            <form action="/posts/new" method="POST">
                <input type="text" name="title" placeholder="Catchy Post Title..." required>
                <textarea name="content" placeholder="Share your thoughts with everyone..." required></textarea>
                <button type="submit" class="btn btn-primary">Publish Entry</button>
            </form>
        </div>

        <h3>Recent Activity Timeline</h3>
        <% if(posts.length === 0) { %> 
            <p style="color: #6c757d;">No records found. Be the first to start the conversation!</p> 
        <% } %>
        
        <!-- Live loop rendering every item inside the Database collection array -->
<!-- Live loop rendering every item inside the Database collection array -->
<% posts.forEach(post => { %>
    <div class="card">
        <h2 style="margin: 0 0 5px 0;"><%= post.title %></h2>
        <div class="meta">
            <!-- 🛡️ Safe check: Uses 'Anonymous' if old posts are missing author fields -->
            Written by <strong>@<%= post.author || 'Anonymous' %></strong> on <%= post.createdAt ? post.createdAt.toDateString() : 'Unknown Date' %>
        </div>
        <p style="line-height:1.6; white-space: pre-wrap;"><%= post.content %></p>
        
        <!-- 🔒 SAFE ACCESS CHECK: Checks if post.authorId exists BEFORE calling .toString() to prevent 500 crashes -->
        <% if (typeof currentUserId !== 'undefined' && currentUserId && post.authorId && currentUserId.toString() === post.authorId.toString()) { %>
            <div style="margin-top:20px;">
                <form action="/posts/delete/<%= post._id %>" method="POST" onsubmit="return confirm('Permanently remove your post?');">
                    <button type="submit" class="btn btn-danger">Delete My Post</button>
                </form>
            </div>
        <% } %>
    </div>
<% }) %>

        
            
        
 </div>

</body>
</html>
